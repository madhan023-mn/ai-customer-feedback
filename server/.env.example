# Server Port
PORT=5000

# MongoDB Database URI (e.g. mongodb://127.0.0.1:27017/loop_db or MongoDB Atlas Connection String)
MONGO_URI=mongodb://127.0.0.1:27017/loop_db

# JWT Secret for authentication tokens (use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Redis Configuration (Optional - automated synchronous fallback activates if Redis is offline)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Client CORS URL (in development: http://localhost:5173, in production: https://your-domain.vercel.app)
CLIENT_URL=http://localhost:5173

# AI Provider API Keys (Optional - built-in heuristic & local vector engine activates if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
